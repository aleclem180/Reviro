rules_version = '2';

// Reglas de seguridad de Reviro.
// Se publican en Firebase Console > Firestore Database > Reglas, o con `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Admin fijo: este mail, verificado. Si agregás más mails, sumalos también en js/net.js (ADMIN_EMAILS).
    function isFixedAdmin() {
      return signedIn()
        && request.auth.token.email == 'alejandro.clemente05@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // cuenta suspendida por el admin: no puede jugar, inscribirse ni comprar
    function notBanned() {
      return signedIn() && !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == true);
    }
    function isAdmin() {
      return isFixedAdmin()
        || (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // ---------- nombres de usuario únicos ----------
    // usernames/{usuario en minúsculas} = { uid }
    match /usernames/{name} {
      allow get: if true;                       // para saber si un nombre está libre antes de registrarse
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow delete: if isAdmin();
    }

    // ---------- usuarios, roles y estadísticas ----------
    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isSelf(uid)
        && request.resource.data.role == 'player'
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid
        && request.resource.data.stats == { 'played': 0, 'wins': 0, 'losses': 0, 'winRate': 0, 'currentStreak': 0, 'bestStreak': 0 };

      allow update: if
           // el jugador cambia su personaje
           (isSelf(uid) && changed().hasOnly(['avatar']))
           // el jugador acepta los términos y condiciones
        || (isSelf(uid) && changed().hasOnly(['terms']))
           // el jugador registra el resultado de una partida (ver validStats)
        || (isSelf(uid) && changed().hasOnly(['stats', 'lastMatchId']) && validStats(uid))
           // el admin fijo deja asentado su propio rol
        || (isSelf(uid) && isFixedAdmin() && changed().hasOnly(['role']) && request.resource.data.role == 'admin')
           // un admin cambia el rol de otro usuario
        || (isAdmin() && changed().hasOnly(['role']) && request.resource.data.role in ['player', 'admin'])
           // moderación y premio por referido (solo admin)
        || (isAdmin() && changed().hasOnly(['banned', 'bannedReason', 'refBonus']));

      allow delete: if isAdmin();

      // Una partida solo se puede sumar una vez, y tiene que coincidir con el resultado guardado en la sala.
      function validStats(uid) {
        let id = request.resource.data.lastMatchId;
        let recPath = /databases/$(database)/documents/users/$(uid)/matches/$(id);
        let o = resource.data.stats;
        let n = request.resource.data.stats;
        let won = getAfter(recPath).data.won;
        return id is string
          && !exists(recPath) && existsAfter(recPath)
          && n.keys().hasOnly(['played', 'wins', 'losses', 'winRate', 'currentStreak', 'bestStreak'])
          && n.played == o.played + 1
          && n.winRate is number && n.winRate >= 0 && n.winRate <= 1
          && ((won == true
                && n.wins == o.wins + 1 && n.losses == o.losses
                && ((o.currentStreak > 0 && n.currentStreak == o.currentStreak + 1) || (o.currentStreak <= 0 && n.currentStreak == 1)))
           || (won == false
                && n.wins == o.wins && n.losses == o.losses + 1
                && ((o.currentStreak < 0 && n.currentStreak == o.currentStreak - 1) || (o.currentStreak >= 0 && n.currentStreak == -1))))
          && ((n.currentStreak > o.bestStreak && n.bestStreak == n.currentStreak)
           || (n.currentStreak <= o.bestStreak && n.bestStreak == o.bestStreak));
      }

      match /matches/{matchId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid) && validRecord(uid, matchId);
        allow update, delete: if false;

        function validRecord(uid, matchId) {
          let d = request.resource.data;
          let room = get(/databases/$(database)/documents/rooms/$(d.roomId)).data;
          return d.matchId == matchId
            // solo cuentan las partidas online (al menos dos personas); contra la IA no va al historial
            && room.playerIds.size() >= 2
            && uid in room.teams
            && d.team == room.teams[uid]
            && (
              // partida terminada: el resultado tiene que coincidir con el de la sala
              (room.status == 'finished'
                && room.result.matchId == matchId
                && d.won == (room.result.winnerTeam == room.teams[uid]))
              // abandono: salir de una partida en juego cuenta como derrota
              || (room.status == 'playing'
                && room.matchId == matchId
                && d.abandoned == true
                && d.won == false)
            );
        }
      }

      match /private/{docId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }
    }

    // ---------- salas en tiempo real ----------
    match /rooms/{code} {
      function isMember() {
        return request.auth.uid in resource.data.playerIds || resource.data.host == request.auth.uid;
      }
      // alguien que no está en la sala solo puede sentarse en un asiento libre mientras se espera
      function joining() {
        return resource.data.status == 'waiting'
          && request.auth.uid in request.resource.data.playerIds
          && changed().hasOnly(['seats', 'playerIds', 'type', 'updatedAt']);
      }

      allow read: if signedIn();
      allow create: if notBanned()
        && request.resource.data.host == request.auth.uid
        && request.resource.data.status == 'waiting'
        // entrada: amistosa o desde 1.000 fichas (contra la IA puede ser menos)
        && (request.resource.data.stake == 0 || request.resource.data.stake >= 1000 || request.resource.data.seats[1].bot == true)
        && request.resource.data.code == code
        && request.resource.data.n in [2, 4];
      allow update: if signedIn()
        && (isMember() || joining() || isAdmin())
        && request.resource.data.host == resource.data.host
        && request.resource.data.code == resource.data.code
        && request.resource.data.status in ['waiting', 'playing', 'finished', 'closed']
        // una sala terminada no cambia de resultado (salvo revancha, que vuelve a 'playing')
        && (resource.data.status != 'finished' || request.resource.data.status in ['playing', 'closed', 'finished']);
      allow delete: if isAdmin() || (signedIn() && resource.data.host == request.auth.uid);

      match /presence/{uid} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }
      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.by == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ---------- torneos (entrada y premios en fichas, sin valor en dinero) ----------
    match /tournaments/{tid} {
      function T() { return resource.data; }
      function capOf(t) { return t.maxTeams * (t.mode == '2v2' ? 2 : 1); }
      function entryPath(u) { return /databases/$(database)/documents/tournaments/$(tid)/entries/$(u); }

      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        // inscribirse o darse de baja: solo cambia la cantidad de inscriptos, junto con la inscripción
        || (signedIn() && T().status == 'open' && changed().hasOnly(['players', 'updatedAt'])
            && ((request.resource.data.players == T().players + 1 && request.resource.data.players <= capOf(T())
                 && (T().startAt == null || request.time.toMillis() < T().startAt)
                 && !exists(entryPath(request.auth.uid)) && existsAfter(entryPath(request.auth.uid)))
             || (request.resource.data.players == T().players - 1
                 && exists(entryPath(request.auth.uid)) && !existsAfter(entryPath(request.auth.uid)))))
        // cerrar el torneo con el podio cuando se jugó todo (lo hace cualquiera de los inscriptos)
        || (signedIn() && T().status in ['running', 'paused'] && request.resource.data.status == 'finished'
            && changed().hasOnly(['status', 'places', 'finishedAt', 'updatedAt'])
            && exists(entryPath(request.auth.uid)));

      match /entries/{uid} {
        function tour() { return get(/databases/$(database)/documents/tournaments/$(tid)).data; }
        allow read: if signedIn();
        allow create: if isSelf(uid) && notBanned() && tour().status == 'open'
          && (tour().startAt == null || request.time.toMillis() < tour().startAt)
          && request.resource.data.uid == uid
          && request.resource.data.partner == null
          && (request.resource.data.team == uid
              || (tour().mode == '2v2'
                  && get(/databases/$(database)/documents/tournaments/$(tid)/entries/$(request.resource.data.team)).data.team == request.resource.data.team
                  && get(/databases/$(database)/documents/tournaments/$(tid)/entries/$(request.resource.data.team)).data.partner == null
                  && getAfter(/databases/$(database)/documents/tournaments/$(tid)/entries/$(request.resource.data.team)).data.partner == uid))
          && getAfter(/databases/$(database)/documents/tournaments/$(tid)).data.players == tour().players + 1;
        // sumarse a una pareja (o dejarla): solo se toca el campo partner de quien la armó
        allow update: if isAdmin()
          || (signedIn() && tour().status == 'open' && changed().hasOnly(['partner'])
              && ((resource.data.partner == null && request.resource.data.partner == request.auth.uid
                   && getAfter(/databases/$(database)/documents/tournaments/$(tid)/entries/$(request.auth.uid)).data.team == uid)
               || (resource.data.partner == request.auth.uid && request.resource.data.partner == null
                   && !existsAfter(/databases/$(database)/documents/tournaments/$(tid)/entries/$(request.auth.uid)))));
        allow delete: if isAdmin()
          || (isSelf(uid) && tour().status == 'open'
              && getAfter(/databases/$(database)/documents/tournaments/$(tid)).data.players == tour().players - 1);
      }

      match /matches/{mid} {
        function M() { return resource.data; }
        function N() { return request.resource.data; }
        // el resultado tiene que coincidir con el de la sala del partido
        function validResult() {
          let room = get(/databases/$(database)/documents/rooms/$(M().room)).data;
          return changed().hasOnly(['winner', 'pts', 'forfeit', 'updatedAt'])
            && M().winner == null && N().winner in ['a', 'b']
            && room.status == 'finished' && room.tour.tid == tid && room.tour.mid == mid
            && room.result.winnerTeam == (N().winner == 'a' ? 0 : 1)
            && M().a.ids[0] in room.teams && room.teams[M().a.ids[0]] == 0;
        }
        // pasar a la ronda siguiente: el lugar se llena con el ganador (o el perdedor, en el tercer puesto) del partido anterior
        function validFill(slot) {
          let src = get(/databases/$(database)/documents/tournaments/$(tid)/matches/$(M().from[slot])).data;
          let side = M().get('loser', false) == true ? (src.winner == 'a' ? 'b' : 'a') : src.winner;
          return changed().hasOnly([slot, 'updatedAt']) && M()[slot] == null
            && src.winner in ['a', 'b'] && N()[slot] == src[side];
        }
        allow read: if signedIn();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (signedIn() && (validResult() || validFill('a') || validFill('b')));
      }

      // cuentas internas del torneo (recaudación, premio, casa): solo el admin
      match /private/{docId} {
        allow read, write: if isAdmin();
      }
      // movimientos de fichas: entradas, bajas, premios y reintegros
      match /ledger/{id} {
        function tour() { return get(/databases/$(database)/documents/tournaments/$(tid)).data; }
        allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.kind in ['entrada', 'baja', 'premio', 'reintegro']
          && (request.resource.data.kind == 'premio' || request.resource.data.amount == tour().buyIn);
        allow update, delete: if isAdmin();
      }

      match /claims/{uid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid)
          && get(/databases/$(database)/documents/tournaments/$(tid)).data.status in ['finished', 'cancelled']
          && exists(/databases/$(database)/documents/tournaments/$(tid)/entries/$(uid))
          && request.resource.data.uid == uid;
        allow update, delete: if false;
      }
    }

    // ---------- monedas con Mercado Pago ----------
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /purchases/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      // el jugador avisa que pagó: queda pendiente hasta que el admin lo vea en Mercado Pago
      allow create: if notBanned() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pendiente' && request.resource.data.applied == false;
      allow update: if isAdmin()
        // el jugador solo marca que ya se le sumaron las monedas de una compra acreditada
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'acreditada'
            && changed().hasOnly(['applied']) && request.resource.data.applied == true);
      allow delete: if isAdmin();
    }

    // ---------- perfil público (personaje, apodo, código de amigo, amigos, puntos) ----------
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    // ---------- billetera privada (fichas, monedas, cosas compradas) ----------
    match /wallets/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isSelf(uid);
    }

    // ---------- referidos ----------
    match /referrals/{uid} {
      allow read: if isAdmin() || isSelf(uid) || (signedIn() && resource.data.referrer == request.auth.uid);
      allow create: if isSelf(uid) && notBanned() && request.resource.data.referrer != uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.referrer))
        && request.resource.data.played == false && request.resource.data.paidReferrer == false;
      allow update: if isAdmin()
        // el invitado avisa que ya jugó su primera partida online
        || (isSelf(uid) && changed().hasOnly(['played']) && request.resource.data.played == true)
        // el que invitó marca que ya cobró su premio
        || (signedIn() && resource.data.referrer == request.auth.uid && resource.data.played == true
            && changed().hasOnly(['paidReferrer']) && request.resource.data.paidReferrer == true);
      allow delete: if isAdmin();
    }

    // ---------- ajustes de saldo que hace el admin ----------
    match /grants/{uid}/items/{id} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin() && request.resource.data.by == request.auth.uid && request.resource.data.applied == false;
      allow update: if isAdmin() || (isSelf(uid) && changed().hasOnly(['applied']) && request.resource.data.applied == true);
      allow delete: if false;
    }

    // ---------- registro de acciones del admin: no se edita ni se borra ----------
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- premium: solo lo da un admin ----------
    match /premium/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- invitaciones a mesa ----------
    match /invites/{id} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
  }
}
